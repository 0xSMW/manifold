{
  "name": "@manifold/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Manifold Drizzle schema (SPEC §6), migrations, and typed DB access. The ONLY package allowed to import drizzle-orm / postgres (SPEC §4.2).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs"
  },
  "dependencies": {
    "@manifold/contracts": "*",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3"
  }
}
