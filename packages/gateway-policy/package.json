    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@manifold/contracts": "0.0.0",
    "@manifold/domain": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  }
}
