# =============================================================================
# Manifold — environment template (NO real secrets in this file)
# =============================================================================
# Two runtimes read these:
#   [CP] apps/control-plane  — Next.js 16 app, deployed to Vercel (team: ai-marketing)
#   [GW] apps/gateway        — long-running node:http service, runs on a container/VM
#
# Vars marked [CP+GW] MUST hold the IDENTICAL value in both runtimes or auth /
# credential decryption / snapshot verification will fail. See docs/DEPLOY.md.
#
# Generate every secret with the exact command shown. Do NOT commit filled values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon)
# -----------------------------------------------------------------------------
# [CP+GW] Runtime connection used by the app/gateway. Connect as the NON-superuser
# role `manifold_app` (migration 0002) so RLS (§6.16) is load-bearing. Use Neon's
# POOLED host (the "-pooler" endpoint). Neon dashboard → Connection Details →
# "Pooled connection", then swap the role to manifold_app + its password.
#   postgresql://manifold_app:<app_pw>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# [GW] Optional. Dedicated DB URL for the gateway's hard-budget reservations
# (@manifold/budget). Falls back to DATABASE_URL when unset — leave blank to share.
MANIFOLD_BUDGET_DB_URL=

# [CP] Privileged (DB owner, e.g. neondb_owner) connection used ONLY by the
# bootstrap seed route to write the global reference/catalog tables that the
# app role is REVOKEd from (canonical_model, provider_model_offering,
# provider_price_revision). NOT used on the normal request path. Use the DIRECT
# (non-pooled) Neon host. Leave unset in steady state after seeding.
MANIFOLD_SEED_DB_URL=

# -----------------------------------------------------------------------------
# Data KEK — wraps per-credential DEKs that seal provider secrets (§14.3)
# -----------------------------------------------------------------------------
# [CP+GW] base64 of EXACTLY 32 random bytes. Required in production (the app/gateway
# THROW rather than fall back to the all-zero dev KEK). Generate:
#   openssl rand -base64 32
MANIFOLD_DATA_KEK=

# [CP] Identifier stamped alongside sealed credentials (defaults to "kek_dev").
# Set a stable, human-readable id so key rotation is traceable, e.g. kek_prod_1.
MANIFOLD_DATA_KEK_ID=kek_prod_1

# -----------------------------------------------------------------------------
# Key pepper — HMAC pepper for virtual-key hashing (§14.3)
# -----------------------------------------------------------------------------
# [CP+GW] High-entropy secret string. Required in production (the app/gateway refuse
# the dev pepper). The gateway's snapshot key hashes are HMAC(pepper, key), so this
# MUST match the control plane or every virtual key returns AUTH_KEY_UNKNOWN. Generate:
#   openssl rand -hex 32
MANIFOLD_KEY_PEPPER=

# -----------------------------------------------------------------------------
# Snapshot signing (ed25519, §7.3 / ADR-0024)
# -----------------------------------------------------------------------------
# The control plane signs config snapshots with the PRIVATE seed; the gateway pins
# only the PUBLIC half and verifies on load (fail-closed in production).
# Generate BOTH halves at once (base64 of the raw 32-byte seed / 32-byte public key):
#   node -e 'const{generateKeyPairSync}=require("node:crypto");const{publicKey,privateKey}=generateKeyPairSync("ed25519");const pk=privateKey.export({format:"der",type:"pkcs8"});const pub=publicKey.export({format:"der",type:"spki"});console.log("MANIFOLD_SNAPSHOT_SIGNING_KEY="+Buffer.from(pk.subarray(pk.length-32)).toString("base64"));console.log("MANIFOLD_SNAPSHOT_PUBLIC_KEY="+Buffer.from(pub.subarray(pub.length-32)).toString("base64"))'

# [CP] base64 32-byte ed25519 PRIVATE seed. Signs snapshots on /config/apply.
MANIFOLD_SNAPSHOT_SIGNING_KEY=

# [CP] Optional key id stamped into snapshot meta.signingKeyId (rotation trace).
MANIFOLD_SNAPSHOT_SIGNING_KEY_ID=snap_prod_1

# [GW] base64 32-byte ed25519 PUBLIC key — the public half of the signing key above.
# Required in production; without it the gateway refuses to load a snapshot (fail closed).
MANIFOLD_SNAPSHOT_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Production key enforcement
# -----------------------------------------------------------------------------
# [CP+GW] Set to 1 to force real-key enforcement even if NODE_ENV is not "production".
# Vercel sets NODE_ENV=production automatically; set NODE_ENV=production on the gateway VM.
MANIFOLD_REQUIRE_REAL_KEYS=1

# [GW] Set to 1/true to force snapshot signature verification outside production.
# Redundant when NODE_ENV=production (already required); keep as belt-and-suspenders.
MANIFOLD_REQUIRE_SIGNED=1

# -----------------------------------------------------------------------------
# Bootstrap seed guard
# -----------------------------------------------------------------------------
# [CP] Shared secret guarding POST /api/v1/admin/seed (creates the first workspace,
# owner, api_token, installation, profile + reference catalog). Sent as the
# `x-seed-secret` header. Generate:
#   openssl rand -hex 32
MANIFOLD_SEED_SECRET=

# -----------------------------------------------------------------------------
# Gateway service
# -----------------------------------------------------------------------------
# [GW] Listen port for the node:http gateway (default 8787).
PORT=8787

# [GW] Path to the SIGNED snapshot file the gateway loads (default ./snapshot.example.json,
# which is UNSIGNED and will be REJECTED in production). Point this at the signed bytes
# fetched from the control plane's GET /api/v1/config/active (see docs/DEPLOY.md step F).
MANIFOLD_SNAPSHOT=./snapshot.active.json

# [GW] Skeleton-only provider secret injected upstream by the passthrough gateway.
# The real path decrypts the encrypted credmap in-proc (no env). Only needed while the
# gateway still reads the provider key from env (see apps/gateway/README.md TODOs).
ANTHROPIC_API_KEY=
