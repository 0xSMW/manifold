# =============================================================================
# Manifold — environment template (NO real secrets in this file)
# =============================================================================
# Two runtimes read these:
#   [CP] apps/control-plane  — Next.js 16 app, deployed to Vercel (team: ai-marketing)
#   [GW] apps/gateway        — Vercel Node.js Fluid function; node:http remains a local harness
#
# Vars marked [CP+GW] MUST hold the IDENTICAL value in both runtimes or auth /
# credential decryption / snapshot verification will fail. See docs/DEPLOY.md.
#
# Generate every secret with the exact command shown. Do NOT commit filled values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon)
# -----------------------------------------------------------------------------
# [CP+GW] Runtime connection used by the app/gateway. Connect as the NON-superuser
# role `manifold_app` (migration 0002) so RLS (§6.16) is load-bearing. Use Neon's
# POOLED host (the "-pooler" endpoint). Neon dashboard → Connection Details →
# "Pooled connection", then swap the role to manifold_app + its password.
#   postgresql://manifold_app:<app_pw>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# [GW] Optional. Dedicated DB URL for the gateway's hard-budget reservations
# (@manifold/budget). Falls back to DATABASE_URL when unset — leave blank to share.
MANIFOLD_BUDGET_DB_URL=

# [CP] Privileged (DB owner, e.g. neondb_owner) connection used ONLY by the
# bootstrap seed route to write the global reference/catalog tables that the
# app role is REVOKEd from (canonical_model, provider_model_offering,
# provider_price_revision). NOT used on the normal request path. Use the DIRECT
# (non-pooled) Neon host. Leave unset in steady state after seeding.
MANIFOLD_SEED_DB_URL=

# [CP] Direct, unpooled database URL used only by the storage compaction worker.
# This route exports, verifies, checkpoints, then drops an eligible partition in one direct-DB flow.
DATABASE_URL_DIRECT=

# [CP] Internal worker authentication. Generate: openssl rand -hex 32
MANIFOLD_STORAGE_COMPACTION_SECRET=

# [CP] Base64 of exactly 32 random bytes. Encrypts short-lived idempotency replay bodies
# for copy-once key mint/rotation responses. Generate: openssl rand -base64 32
MANIFOLD_MUTATION_REPLAY_KEY=

# [CP] Base64 of exactly 32 random bytes. Encrypts persisted invitation capabilities for
# crash-safe delivery recovery. Generate: openssl rand -base64 32
MANIFOLD_INVITATION_DELIVERY_KEY=

# [CP] Optional direct audit-delivery worker credential. The Vercel cron path uses CRON_SECRET.
# Generate: openssl rand -hex 32
MANIFOLD_AUDIT_DELIVERY_SECRET=

# [CP] S3-compatible retention export. exportLocation is an s3://bucket/optional-prefix URI;
# this endpoint is deliberately path-style so it supports S3-compatible providers without an SDK.
# The credentials must have PutObject and HeadObject only for the configured archive prefix and
# must not have DeleteObject permission. The worker uses If-None-Match: * and verifies HEAD
# content-length plus immutable SHA-256 metadata before authorizing a partition drop.
MANIFOLD_OBJECT_STORAGE_ENDPOINT=
MANIFOLD_OBJECT_STORAGE_REGION=
MANIFOLD_OBJECT_STORAGE_ACCESS_KEY_ID=
MANIFOLD_OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional temporary-credential session token.
MANIFOLD_OBJECT_STORAGE_SESSION_TOKEN=

# [CP optional] Route-test diagnostics. Set both values together to let the control plane send
# a bounded synthetic request through the deployed gateway. The token is a dedicated Manifold
# virtual key for diagnostics; never reuse a provider credential.
MANIFOLD_GATEWAY_DIAGNOSTICS_URL=
MANIFOLD_GATEWAY_DIAGNOSTICS_TOKEN=

# -----------------------------------------------------------------------------
# Data KEK — wraps per-credential DEKs that seal provider secrets (§14.3)
# -----------------------------------------------------------------------------
# [CP+GW] base64 of EXACTLY 32 random bytes. Required in production (the app/gateway
# THROW rather than fall back to the all-zero dev KEK). Generate:
#   openssl rand -base64 32
MANIFOLD_DATA_KEK=

# [GW] Preferred rotation keyring. Strict JSON object with one to four
# kekId -> base64 32-byte KEK entries. It takes precedence for snapshots that
# carry a target kekId; keep the retiring entry until every active/LKG snapshot
# has moved to the new id.
MANIFOLD_DATA_KEKS=

# [CP] Identifier stamped alongside sealed credentials (defaults to "kek_dev").
# Set a stable, human-readable id so key rotation is traceable, e.g. kek_prod_1.
MANIFOLD_DATA_KEK_ID=kek_prod_1

# -----------------------------------------------------------------------------
# Key pepper — HMAC pepper for virtual-key hashing (§14.3)
# -----------------------------------------------------------------------------
# [CP+GW] High-entropy secret string. Required in production (the app/gateway refuse
# the dev pepper). The gateway's snapshot key hashes are HMAC(pepper, key), so this
# MUST match the control plane or every virtual key returns AUTH_KEY_UNKNOWN. Generate:
#   openssl rand -hex 32
MANIFOLD_KEY_PEPPER=

# [GW] Preferred overlap form during rotation. Strict JSON array containing one
# or two nonempty peppers in [new, old] order. The gateway tries both hashes and
# preserves first-match semantics; remove the old value after the revocation SLA.
MANIFOLD_KEY_PEPPERS=

# -----------------------------------------------------------------------------
# Snapshot signing (ed25519, §7.3 / ADR-0024)
# -----------------------------------------------------------------------------
# The control plane signs config snapshots with the PRIVATE seed; the gateway pins
# only the PUBLIC half and verifies on load (fail-closed in production).
# Generate BOTH halves at once (base64 of the raw 32-byte seed / 32-byte public key):
#   node -e 'const{generateKeyPairSync}=require("node:crypto");const{publicKey,privateKey}=generateKeyPairSync("ed25519");const pk=privateKey.export({format:"der",type:"pkcs8"});const pub=publicKey.export({format:"der",type:"spki"});console.log("MANIFOLD_SNAPSHOT_SIGNING_KEY="+Buffer.from(pk.subarray(pk.length-32)).toString("base64"));console.log("MANIFOLD_SNAPSHOT_PUBLIC_KEY="+Buffer.from(pub.subarray(pub.length-32)).toString("base64"))'

# [CP] base64 32-byte ed25519 PRIVATE seed. Signs snapshots on /config/apply.
MANIFOLD_SNAPSHOT_SIGNING_KEY=

# [CP] Optional key id stamped into snapshot meta.signingKeyId (rotation trace).
MANIFOLD_SNAPSHOT_SIGNING_KEY_ID=snap_prod_1

# [GW] base64 32-byte ed25519 PUBLIC key — the public half of the signing key above.
# Required in production; without it the gateway refuses to load a snapshot (fail closed).
MANIFOLD_SNAPSHOT_PUBLIC_KEY=

# [GW] Rotation overlap alternative to the single pin above. Strict JSON object with at most four
# signingKeyId -> base64 Ed25519 public-key entries. When set, it takes precedence and a snapshot
# must name an exact listed meta.signingKeyId.
MANIFOLD_SNAPSHOT_PUBLIC_KEYS=

# -----------------------------------------------------------------------------
# Production key enforcement
# -----------------------------------------------------------------------------
# [CP+GW] Set to 1 to force real-key enforcement even if NODE_ENV is not "production".
# Vercel sets NODE_ENV=production automatically; set NODE_ENV=production on the gateway VM.
MANIFOLD_REQUIRE_REAL_KEYS=1

# [GW] Set to 1/true to force snapshot signature verification outside production.
# Redundant when NODE_ENV=production (already required); keep as belt-and-suspenders.
MANIFOLD_REQUIRE_SIGNED=1

# -----------------------------------------------------------------------------
# Bootstrap seed guard
# -----------------------------------------------------------------------------
# [CP] Shared secret guarding POST /api/v1/admin/seed (creates the first workspace,
# owner, api_token, installation, profile + reference catalog). Sent as the
# `x-seed-secret` header. Generate:
#   openssl rand -hex 32
MANIFOLD_SEED_SECRET=

# [CP bootstrap optional] Base domain used only when the seed request omits an explicit hostname.
# The route derives <workspace-slug>.<domain>. Prefer passing the final deployable gateway hostname
# explicitly. `.local` names are rejected.
MANIFOLD_SEED_GATEWAY_DOMAIN=

# -----------------------------------------------------------------------------
# First-party human authentication (control plane only)
# -----------------------------------------------------------------------------
# Auth links must always point at the canonical control-plane origin. In production
# this must be an HTTPS origin only (no path, query, fragment, or credentials).
MANIFOLD_AUTH_ORIGIN=https://console.manifold.example

# [CP optional] Separate canonical origin only when CLI device approval is hosted on
# a different control-plane origin. Normally leave unset: CLI verification uses
# MANIFOLD_AUTH_ORIGIN and enforces the same production HTTPS/origin-only rules.
MANIFOLD_CONSOLE_ORIGIN=

# HMAC pepper for opaque activation, password-reset, and invitation capabilities
# and human console sessions. Required in production. Generate:
#   openssl rand -hex 32
# This is independent from MANIFOLD_KEY_PEPPER, which protects gateway/API keys.
MANIFOLD_AUTH_TOKEN_PEPPER=

# Resend transactional email for first-owner activation, invitations, and password
# resets. RESEND_FROM_EMAIL must use a sender on a Resend-verified domain.
# Do not use a personal mailbox or copy another project's value into this project.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Gateway service
# -----------------------------------------------------------------------------
# [GW local only] Listen port for the node:http development harness.
PORT=8787

# [GW local only] Signed snapshot file for the node:http development harness. The Vercel
# function loads signed snapshots remotely and never depends on a writable/local runtime file.
MANIFOLD_SNAPSHOT=./snapshot.active.json

# [GW] One Vercel gateway project serves one installation/workspace binding.
MANIFOLD_INSTALLATION_ID=
MANIFOLD_WORKSPACE_ID=

# [GW] Authoritative signed-snapshot boot fallback. Requests are signed with the
# installation Ed25519 private key; the control-plane URL must be a bare HTTPS origin.
MANIFOLD_CONTROL_PLANE_URL=https://manifold.example
MANIFOLD_INSTALLATION_PRIVATE_KEY=

# [GW optional] Full accelerator endpoint. Its token is separate by design; the control-plane
# token is never sent to this URL.
MANIFOLD_SNAPSHOT_ACCELERATOR_URL=
MANIFOLD_SNAPSHOT_ACCELERATOR_TOKEN=

# [GW] Snapshot freshness/revocation window and defensive fetch limits.
MANIFOLD_SNAPSHOT_FRESH_MS=5000
MANIFOLD_SNAPSHOT_MAX_STALE_MS=60000
MANIFOLD_SNAPSHOT_TIMEOUT_MS=2000
MANIFOLD_SNAPSHOT_MAX_BYTES=1048576

# [GW] Production admission is a strict fleet-wide Postgres authority. Every authenticated
# request holds an expiring lease and atomically consumes its key's RPM/TPM buckets. The lease
# must outlive Vercel's 300-second gateway maximum so a valid invocation cannot outlive its slot.
MANIFOLD_ADMISSION_MODE=postgres_strict
MANIFOLD_ADMISSION_LEASE_TTL_MS=330000

# [GW] Runtime resource guards. The concurrency values are enforced by strict admission across
# the fleet. The request limit and circuit breaker remain bounded within each Fluid isolate.
MANIFOLD_MAX_REQUEST_BYTES=4000000
MANIFOLD_MAX_KEY_CONCURRENCY=16
MANIFOLD_MAX_CONCURRENCY=128
MANIFOLD_CONCURRENCY_MAX_KEYS=10000
MANIFOLD_CIRCUIT_FAILURE_THRESHOLD=5
MANIFOLD_CIRCUIT_WINDOW_MS=60000
MANIFOLD_CIRCUIT_RESET_MS=30000
MANIFOLD_CIRCUIT_MAX_TARGETS=10000

# [GW optional] Standard OpenTelemetry variables are consumed by @vercel/otel when exporting
# to a configured collector. Vercel traces/logs remain available without a custom endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# [CP and GW] Vercel Cron authenticates each project's internal worker routes with this bearer
# secret. Configure it independently in both Vercel projects; the values do not need to match.
# Generate each with: openssl rand -hex 32
CRON_SECRET=
